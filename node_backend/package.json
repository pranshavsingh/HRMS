{
  "name": "hrms-node-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "start:cluster": "pm2 start ecosystem.config.cjs --env production",
    "test:security": "node tests/security/run_all.js",
    "test:concurrency": "node --test tests/concurrency/attendance_concurrency.test.js",
    "test:pagination": "node --test tests/pagination/pagination.test.js",
    "test:performance": "node --test tests/performance/load_simulation.test.js",
    "test:phase2": "node tests/run_phase2.js",
    "test:all": "npm run test:security && npm run test:phase2",
    "check": "node --check src/server.js && node --check src/worker.js",
    "db:init:mysql": "node scripts/init-mysql.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:migrate:sqlite-to-mysql": "node scripts/migrate-sqlite-to-mysql.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "file-type": "^22.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.24.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.5.0",
    "nodemon": "3.1.11",
    "rate-limit-redis": "^6.0.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}

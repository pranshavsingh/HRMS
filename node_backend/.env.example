PORT=8000
JWT_SECRET=change-me-in-production
DB_CLIENT=mysql
DB_PATH=./db.sqlite3
MYSQL_HOST=srv999.hstgr.io
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name
MYSQL_CONNECTION_LIMIT=30

# Redis Cache & Realtime Pub/Sub
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
MAIL_FROM=HRMS <your-email@yourdomain.com>
OTP_SECRET=change-me-random-string
OTP_EXPIRY_MINUTES=10
MEDIA_ROOT=./src/uploads
CORS_ORIGIN=*

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ATTENDANCE_PRESET=attendance_preset
CLOUDINARY_DOCUMENTS_PRESET=documents_preset

# Phase 3 — Distributed Queue & Outbox Configuration
QUEUE_REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=hrms
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_DEFAULT_BACKOFF_MS=1000
QUEUE_JOB_REMOVE_ON_COMPLETE=100
QUEUE_JOB_REMOVE_ON_FAIL=500
OUTBOX_ENCRYPTION_KEY=your_32_character_or_64_hex_secret_key_for_aes_256_gcm
